# Copy this to .env and point it at your Django + DRF backend once it's live.
# Leaving this unset runs the frontend entirely on mock data.
#
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api
#
# Deployment (Vercel): set this in the project's Environment Variables to the
# deployed backend, then REDEPLOY so it is baked into the build (Vite inlines
# env vars at build time — changing it without redeploying has no effect):
#   VITE_API_BASE_URL=https://<your-backend>.onrender.com/api
